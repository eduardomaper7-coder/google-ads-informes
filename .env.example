# ─────────────────────────────────────────────────────────────
#  Credenciales de la API de Google Ads
#  Copia este archivo como .env.local para desarrollo local
#  y añade las mismas variables en Vercel > Settings > Environment Variables
# ─────────────────────────────────────────────────────────────

# Token de desarrollador (Google Ads > Herramientas > Centro de API)
GOOGLE_ADS_DEVELOPER_TOKEN=

# Credenciales OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth "App de escritorio")
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token: se obtiene una sola vez con  npm run token
GOOGLE_ADS_REFRESH_TOKEN=

# ID de la cuenta administrador (MCC) desde la que accedes a los clientes.
# Solo dígitos, sin guiones. Ej: 1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Versión de la API (opcional). Por defecto v25.
GOOGLE_ADS_API_VERSION=v25

# Contraseña para entrar en la herramienta (opcional pero MUY recomendable,
# porque la app se despliega en una URL pública de Vercel).
# Si la dejas vacía, la app no pide contraseña.
APP_PASSWORD=
